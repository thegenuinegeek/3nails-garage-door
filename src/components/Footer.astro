---
// Footer.astro
const currentYear = new Date().getFullYear();
---
<footer class="bg-stone-900 text-white mt-auto">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-16">
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 lg:gap-12">
      <!-- Brand & About -->
      <div class="lg:col-span-5">
        <h3 class="text-xl font-bold mb-4">3 Nails Garage Door</h3>
        <p class="text-stone-400 mb-4 max-w-md leading-relaxed">
          With over 20 years of experience, we are your trusted partner for all garage door and gate opener needs. Expert repairs, full replacements, and reliable service you can count on.
        </p>
      </div>
      
      <!-- Quick Links -->
      <div class="lg:col-span-4">
        <h4 class="text-lg font-semibold mb-6 text-stone-200">Quick Links</h4>
        <ul class="grid grid-cols-2 gap-x-8 gap-y-3 text-stone-400">
          <li><a href="#" class="hover:text-amber-500 transition-colors">Home</a></li>
          <li><a href="#services" class="hover:text-amber-500 transition-colors">Our Services</a></li>
          <li><a href="#about" class="hover:text-amber-500 transition-colors">About Us</a></li>
          <li><a href="#faq" class="hover:text-amber-500 transition-colors">FAQ</a></li>
          <li><a href="#contact" class="hover:text-amber-500 transition-colors">Contact Us</a></li>
          <li><a href="#contact" class="hover:text-amber-500 transition-colors">Get a Quote</a></li>
        </ul>
      </div>
      
      <!-- Contact Info -->
      <div class="lg:col-span-3">
        <h4 class="text-lg font-semibold mb-6 text-stone-200">Contact Us</h4>
        <ul class="space-y-4 text-stone-400">
          <li class="flex items-start gap-3">
            <svg class="w-5 h-5 text-amber-600 flex-shrink-0 mt-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"></path></svg>
            <a href="tel:+10000000000" class="hover:text-amber-500 transition-colors">Need to add phone</a>
          </li>
          <li class="flex items-start gap-3">
            <svg class="w-5 h-5 text-amber-600 flex-shrink-0 mt-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"></path></svg>
            <a href="mailto:info@3nailsgaragedoors.com" class="hover:text-amber-500 transition-colors">info@3nailsgaragedoors.com</a>
          </li>
        </ul>
      </div>
    </div>
    
    <div class="border-t border-stone-800 mt-12 pt-8 flex flex-col md:flex-row justify-between items-center text-sm text-stone-500">
      <p>&copy; {currentYear} 3 Nails Garage Door & Gate Opener. All rights reserved.</p>
      <div class="mt-4 md:mt-0 space-x-4">
        <a href="#" class="hover:text-white transition-colors">Privacy Policy</a>
        <a href="#" class="hover:text-white transition-colors">Terms of Service</a>
      </div>
    </div>
  </div>
</footer>

