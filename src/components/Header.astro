---
// Header.astro
---
<header class="bg-white shadow-sm sticky top-0 z-50">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="flex justify-between items-center h-20">
      <!-- Logo Area -->
      <div class="flex-shrink-0 flex items-center">
        <a href="#" class="flex items-center gap-3 group">
          <img 
            src="images/3-nails-garage-door-gate-opener-logo.jpg" 
            alt="3 Nails Garage Door and Gate Opener Official Logo" 
            class="h-14 w-auto object-contain"
          />
          <span class="font-bold text-xl text-stone-900 tracking-tight hidden sm:block">
            3 Nails <span class="font-light text-stone-500">Garage Door</span>
          </span>
        </a>
      </div>
      
      <!-- Desktop Navigation -->
      <nav class="hidden md:flex space-x-8">
        <a href="#services" class="text-stone-600 hover:text-stone-900 font-medium transition-colors">Services</a>
        <a href="#about" class="text-stone-600 hover:text-stone-900 font-medium transition-colors">About Us</a>
        <a href="#faq" class="text-stone-600 hover:text-stone-900 font-medium transition-colors">FAQ</a>
      </nav>
      
      <!-- CTA Buttons -->
      <div class="hidden md:flex items-center gap-3">
        <a href="tel:+10000000000" class="inline-flex items-center justify-center px-5 py-2.5 border-2 border-stone-200 rounded-md text-sm font-bold text-stone-800 hover:border-amber-700 hover:text-amber-700 transition-colors group">
          <svg class="w-4 h-4 mr-2 text-amber-700 group-hover:animate-pulse" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"></path></svg>
          Call Now
        </a>
        <a href="#contact" class="inline-flex items-center justify-center px-6 py-2.5 border-2 border-amber-700 rounded-md shadow-sm text-sm font-bold text-white bg-amber-700 hover:bg-amber-800 hover:border-amber-800 transition-colors">
          Get a Quote
        </a>
      </div>

      <!-- Mobile menu button -->
      <div class="flex items-center md:hidden">
        <button type="button" class="inline-flex items-center justify-center p-2 rounded-md text-stone-400 hover:text-stone-500 hover:bg-stone-100" aria-expanded="false">
          <span class="sr-only">Open main menu</span>
          <svg class="block h-6 w-6" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor" aria-hidden="true">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16" />
          </svg>
        </button>
      </div>
    </div>
  </div>
</header>

